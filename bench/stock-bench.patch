diff --git a/user/tickrate.c b/user/tickrate.c
new file mode 100644
index 0000000..fd96727
--- /dev/null
+++ b/user/tickrate.c
@@ -0,0 +1,26 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+#define TIMEBASE 10000000UL // QEMU virt: 10 MHz
+
+int
+main(int argc, char *argv[])
+{
+  int n = 30;
+  if (argc > 1)
+    n = atoi(argv[1]);
+
+  int t = uptime();
+  while (uptime() == t) // đợi đến cạnh của tick
+    ;
+  uint64 t0 = gettime();
+  int a = uptime();
+  pause(n);
+  int b = uptime();
+  uint64 t1 = gettime();
+
+  uint64 dt = t1 - t0;
+  int milli = (int)((uint64)(b - a) * 1000UL * TIMEBASE / dt);
+  printf("TICKRATE_MILLIHZ %d ticks=%d\n", milli, b - a);
+  exit(0);
+}
